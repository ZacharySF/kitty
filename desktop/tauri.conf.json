{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kitty! Workspace",
  "mainBinaryName": "kitty-workspace",
  "version": "0.2.2",
  "identifier": "com.zacharysf.kitty",
  "build": { "frontendDist": "../web/dist" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Private local opportunities, learning and planning workspace",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/kitty-web", "binaries/kitty-herdr"],
    "resources": {
      "third_party/herdr/LICENSE": "licenses/herdr/LICENSE",
      ".build/learnharness-legal/": "licenses/learnharness/"
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1", "xdg-utils", "gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-pulseaudio", "pkexec"] },
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/ZacharySF/kitty-releases/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MkU2MjhCQ0U2MDgyQzUKUldURmdtRE9pMkl1cGhOK0R1MVVDK2JxSFdmdEp6UHg0aDc2SU5Kc3E2RXYxVjIzMGlnYzFhNHQK",
      "requireSignedVersion": true
    }
  }
}
