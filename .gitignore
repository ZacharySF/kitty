# Secrets and private runtime configuration. Share *.example templates only.
.env
.env.*
!.env.example
config/*.yaml
config/*.yml
config/build.json
config/gmail_client.json
PRIVATE_CONTEXT.md

# my resumes
resumes/*
!resumes/.gitkeep

# Found jobs, application history, credentials, exports, and caches stay local.
data/*
!data/.gitkeep
.cache/

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.private/

# Built local website and Node dependencies
web/node_modules/
web/dist/

# Native desktop build output and local packaging environments
desktop/target/
desktop/binaries/
desktop/.build/
desktop/result
desktop/gen/
.ruff_cache/
