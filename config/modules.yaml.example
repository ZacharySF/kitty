# Which built-in modules this workspace uses. Copy to config/modules.yaml.
#
#   applyai    jobs, discovery, sources, companies, profile, resumes, questions,
#              preparation, recovery, applications, follow-ups, mail, career reports
#   workspace  notes, documents, canvas, schema, backlinks, flashcards, study,
#              calendar, tasks, opportunities
#
# The shell, settings and AI provider/budget always remain. A workspace without
# this file keeps every module. Changes apply the next time kitty! starts.
enabled: [applyai, workspace]
