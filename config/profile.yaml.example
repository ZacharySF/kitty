# Copy to profile.yaml (gitignored), or run `kitty init`.
# The form filler copies facts exactly as written. Fill in only your own facts;
# blank fields are not filled into applications. Do not commit the local file.
name: ""
first_name: ""                 # optional; defaults to the first word of name
last_name: ""                  # optional; defaults to the last word of name
email: ""
phone: ""
linkedin: ""
github: ""
website: ""

school: ""
school_city: ""                # optional; distinguishes campuses in dropdowns
degree: ""
major: ""
discipline: ""                 # optional; defaults to major
discipline_by_track: {}         # optional: track name -> discipline
standing: ""
graduation: ""                 # YYYY-MM, when known

# Required timeline editors use these explicit records, never the flat education
# fields above. Leave unknown facts null; no dates, earned degrees or employment
# classifications are inferred. Dates, when provided, must be quoted YYYY-MM.
education_records: []
# - school: "Example University"
#   degree: "Bachelor's Degree"
#   field_of_study: "Example Studies"
#   start_date: null
#   end_date: null
#   expected_end_date: "2032-05"
#   current: true
#   graduated: false
#   comments: null
employment_records: []
# - employer: "Example Organization"
#   title: "Example Role"
#   start_date: "2030-06"
#   end_date: "2030-08"
#   current: false
#   employment_type: null        # copy only your confirmed offered classification
#   description: null
#   city: null
#   state: null
#   country: null

home_city: ""
home_state: ""
city_by_track: {}               # optional: track name -> city in the same state
country: ""
commute_radius_miles: 0         # set your own commute preference
open_to_remote: false          # opt in if this matches your preferences
work_authorization: ""          # never inferred or invented
targets: []
