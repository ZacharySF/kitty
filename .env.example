# Copy to .env (gitignored). Nothing here is read until the stage that needs it.

# Stage 3 - LLM triage (the model and the cost cap are in config/triage.yaml)
ANTHROPIC_API_KEY=

# Optional: point at a different database file
# KITTY_DB=data/apply.db

# Stage 2 - USAJOBS (request a key at https://developer.usajobs.gov/apirequest/)
# The email must be the one the key was issued to; it defaults to profile.yaml's email.
# Then set usajobs `enabled: true` in config/sources.yaml.
# USAJOBS_EMAIL=
# USAJOBS_API_KEY=

# Stage 2 - optional Brave web discovery (free seed-only mode needs no key)
# Get a key from https://brave.com/search/api/ and review your provider plan.
# Then opt in with websearch.options.enable_search: true in config/sources.yaml.
# max_queries/max_results/max_pages bound each run; a key alone never enables calls.
# BRAVE_SEARCH_API_KEY=

# Stage 4 - optional push of the daily digest (off by default)
# `kitty today --notify` (and the scheduled run) sends the digest summary only,
# nothing else. Set ONE of these; ntfy wins if both are set.
#
# ntfy: pick a long random topic name (anyone who knows it can read it), then
# subscribe to it in the ntfy app. Messages go to https://ntfy.sh/<topic>.
# NTFY_TOPIC=
#
# Telegram: create a bot with @BotFather (gives the token), send it one message,
# then read your chat id from https://api.telegram.org/bot<token>/getUpdates.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional Google identity connection (local/offline use never requires it).
# Create your own Google Cloud OAuth client of type Desktop app; Google requires
# both its client ID and its (installed-app, non-confidential) client secret.
# No Web application client, Gmail scopes or hosted service are needed.
# Set in the selected workspace's private .env and restart your own instance.
# Full setup: docs/GOOGLE_ONBOARDING.md
KITTY_GOOGLE_CLIENT_ID=
KITTY_GOOGLE_CLIENT_SECRET=
