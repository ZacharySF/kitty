/* Layout and colour for the kitty TUI.
   Colours come from the dark-fantasy theme (tui/theme.py): $primary is the red
   sky, $accent the torchlight, $panel the stone. One meaning per colour. */

Screen {
    background: $background;
}

/* Header on every screen: tabs, then what this screen is for. */
#header {
    height: auto;
    background: $surface;
    border-bottom: tall $primary;
}

#nav-tabs {
    height: auto;
    background: $background;
}

#nav-purpose {
    height: auto;
    padding: 0 1;
}

/* Panels: stone boxes with their title set into the border. */
.panel {
    border: round $primary-darken-1;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 0 1;
    margin: 1 1 0 1;
    height: auto;
}

.panel:focus-within {
    border: round $accent;
}

#dashboard-body {
    height: 1fr;
}

.dash-column {
    width: 1fr;
    height: auto;
}

#profile-body {
    height: 1fr;
}

/* Resume library first; posting-evidence tables stay on their own tab. */
#resume-line, #resume-summary, #resume-library-line, #resume-details {
    padding: 0 2;
    height: auto;
}

#resume-tabs {
    height: 1fr;
}

#resume-body {
    height: 1fr;
}

#resume-body .panel {
    height: 1fr;
}

/* Lines under the header: counts, hints, saved views. */
#views-line, #inbox-line, #inbox-opens, #sources-line, #board-summary {
    padding: 0 2;
    color: $text-muted;
}

#inbox-opens {
    color: $warning;
}

#filter-bar {
    height: 3;
    margin: 0 1;
    display: none;
}

#filter-bar.visible {
    display: block;
}

Input {
    border: tall $panel;
}

Input:focus {
    border: tall $accent;
}

/* Tables */
DataTable {
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--header {
    background: $panel;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--even-row {
    background: $surface;
}

DataTable > .datatable--odd-row {
    background: $background;
}

DataTable:blur > .datatable--cursor {
    background: $primary-darken-2;
}

/* Pipeline board: six columns side by side, each scrolling on its own. */
#board {
    height: 1fr;
    margin-top: 1;
}

.board-column {
    width: 1fr;
    min-width: 22;
    border: round $panel;
    background: $surface;
    margin: 0 1 0 0;
}

.board-column.focused {
    border: round $accent;
}

.board-column-title {
    text-style: bold;
    padding: 0 1;
    background: $panel;
}

.board-cards {
    height: 1fr;
    background: $surface;
}

/* Job detail and the apply session: wide left column, narrow right one. */
#detail-body, #apply-body {
    height: 1fr;
}

#detail-left, #apply-left {
    width: 2fr;
}

#detail-right, #apply-right {
    width: 1fr;
}

#apply-line {
    padding: 0 2;
    height: auto;
}

/* Modals: a dark window over a dimmed screen. */
ModalScreen {
    align: center middle;
    background: $background 70%;
}

.modal {
    width: 72;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    border-title-color: $accent;
    background: $surface;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.modal-hint {
    color: $text-muted;
    margin-top: 1;
}

.field-label {
    color: $text-muted;
    margin-top: 1;
}

#help-table {
    height: 1fr;
}

.help-modal {
    width: 80%;
    height: 80%;
}

Toast {
    background: $panel;
    border-left: tall $accent;
}

Toast.-error {
    border-left: tall $error;
}

Toast.-warning {
    border-left: tall $warning;
}
