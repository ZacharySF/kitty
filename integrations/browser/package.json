{
  "name": "kitty-browser",
  "version": "0.1.0",
  "private": true,
  "description": "rika! for the browser: mirror the page you are reading into rika! and send selections to its Inbox (Firefox and Chromium-family browsers).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "lint:chromium": "web-ext lint --source-dir dist/chromium --self-hosted"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "0.12.6",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "web-ext": "10.8.0"
  }
}
